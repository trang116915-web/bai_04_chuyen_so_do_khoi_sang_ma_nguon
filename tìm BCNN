#include <stdio.h>
int UCNN(int a, int b) {
    while (b != 0) {
        int i = b;
        b = a % b;
        a = i;
    }
    return a;
}
int main() {
    int a, b;
    scanf("%d %d", &a, &b);
    if (a <= 0 || b <= 0) {
      printf("a va b can lon hon 0");
    }
    long long bcnn = ((long long)a * b) / UCNN(a, b);
    printf("BCNN cua %d va %d la: %llf\n", a, b, bcnn);
    return 0;
}
